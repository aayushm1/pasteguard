{
  "manifest_version": 3,
  "name": "PasteGuard: mask sensitive data before AI sees it",
  "short_name": "PasteGuard",
  "version": "0.1.0",
  "description": "Masks emails, phone numbers, card numbers, API keys and client names when you paste into ChatGPT, Claude or Gemini. Runs 100% locally.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "PasteGuard", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*"
      ],
      "js": ["detectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
